// Cloudflare Worker settings for marcantoniopovolo.com (static site, no Worker code).
{
  "name": "portfolio-website",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./",
    // Serve 404.html (with a 404 status) for pages that don't exist.
    "not_found_handling": "404-page"
  }
}
